{
	"name": "@buckles/cli",
	"version": "1.0.0",
	"description": "Background task runner and interactive terminal UI for Buckles factories.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
	"bin": { "buckles": "./dist/bin.js" },
	"files": ["dist", "src"],
	"engines": { "node": ">=22.12.0" },
	"dependencies": { "@buckles/factory": "workspace:*", "tsx": "^4.23.15" },
	"scripts": {
		"build": "tsrs -p tsconfig.json",
		"typecheck": "tsrs --noEmit -p tsconfig.json",
		"test": "pnpm build && node --test test/*.test.mjs",
		"prepack": "pnpm build"
	}
}
