{
  "name": "@buckles/adapters",
  "version": "1.0.0",
  "description": "GitHub model descriptors, session snapshots, gates, and actions for Buckles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "src"],
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "@buckles/factory": "workspace:^", "@github/copilot-sdk": "1.0.29" },
  "scripts": {
    "build": "tsrs -p tsconfig.json",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  }
}